/* Copy this file to cypress.env.json and fill in your own test-account
   values. cypress.env.json is gitignored — never commit real credentials.
   Values here are also overridable via CYPRESS_* environment variables,
   which is what the CI workflow uses (see .github/workflows/ci.yml). */
{
  "userEmail": "your.valid.test.account@example.com",
  "userPassword": "-your-test-account-password-",
  "reg": {
    "name": "Test Registration User",
    "firstName": "Test",
    "lastName": "User",
    "address": "Test Address 1",
    "state": "Test State",
    "city": "Test City",
    "zipcode": "00000",
    "mobile": "0000000000"
  }
}
